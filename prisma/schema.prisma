generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // 플랫폼 공개 표시명 — 중복 불가 (대소문자 무시: nicknameNormalized)
  nickname           String?
  nicknameNormalized String?  @unique
  phone        String?
  birthDate    String?
  emailVerifiedAt    DateTime?
  emailVerifyToken   String?   @unique
  emailVerifyExpires DateTime?
  notifyEmail        Boolean   @default(true)
  notifyEndingSoon   Boolean   @default(true)
  // MEMBER | ARTIST | GALLERY | ADMIN
  role         String   @default("MEMBER")
  artistStatus String   @default("NONE")
  // 온보딩에서 수집하는 관람 취향 (JSON 배열)
  interestTags  String   @default("[]")
  visitPurposes String   @default("[]")
  onboardedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artistApplication   ArtistApplication?
  exhibitions         Exhibition[]       @relation("RegisteredExhibitions")
  reviewedExhibitions Exhibition[]       @relation("ReviewedExhibitions")
  curations           Curation[]
  reservations        Reservation[]
  saves               SaveExhibition[]
  visits              Visit[]
  reviews             Review[]
  eventLogs           EventLog[]
  notificationLogs    NotificationLog[]
  ownedSpaces         Space[]            @relation("OwnedSpaces")
  hostedPrograms      Program[]          @relation("HostedPrograms")
  placeTips           PlaceTip[]
  questionsAsked      ArtistQuestion[]   @relation("QuestionsAsked")
  questionsReceived   ArtistQuestion[]   @relation("QuestionsReceived")
  decks               UserDeck[]
  savedCards          SavedCard[]
  notices             Notice[]
  calendarEntries     CalendarEntry[]
  calendarShares      CalendarShare[]
}

model ArtistApplication {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String
  portfolioUrl String?
  activityArea String?
  status       String   @default("PENDING")
  // 공개 프로필 정보 (승인된 작가만 노출)
  discipline      String?
  instagramUrl    String?
  profileImageUrl String?
  // 홈에 술래(아바타)로 떠다니는 것에 대한 명시적 동의. 기본 꺼짐.
  showOnHome      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 지속적으로 존재하는 작가의 실제 공간 (공방·쇼룸·레지던시)
// Place(카페/식당/산책 거점)와 구분되는 1급 객체
model Space {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  // STUDIO | SHOWROOM | RESIDENCY | SHARED_SPACE
  type        String  @default("SHOWROOM")
  ownerUserId String?
  region      String  @default("서울")
  district    String
  address     String
  lat         Float
  lng         Float
  // 공방 호수/층 (예: "지하 1층 12호")
  floorOrUnit String?
  shortDescription String?
  description      String?
  // 자유 구성 소개 본문 (텍스트/이미지 블록 JSON)
  // [{ "type":"text","text":"..." }, { "type":"image","url":"...","caption":"..." }]
  storyJson        String  @default("[]")
  heroTone         String  @default("linear-gradient(135deg, #efe6da 0%, #b8a68e 55%, #5c4a3a 100%)")
  heroImageUrl     String?
  // 추가 이미지 URL 목록 (JSON 배열) — storyJson 미사용 시 갤러리로 표시
  imageUrls        String  @default("[]")
  // 방문 정책: WALK_IN | HOURS | APPOINTMENT | PROGRAM_ONLY | CLOSED
  visitPolicy      String  @default("HOURS")
  // 방문 안내 문구 (운영 시간·주의사항 등 자유 텍스트)
  visitNotice      String?
  // 요일별 운영시간 (JSON 객체, 예: {"tue":"11:00-18:00"})
  openingHours     String  @default("{}")
  isPublic  Boolean  @default(true)
  // PUBLISHED | DRAFT | HIDDEN
  status    String   @default("PUBLISHED")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User?          @relation("OwnedSpaces", fields: [ownerUserId], references: [id], onDelete: SetNull)
  exhibitions   Exhibition[]
  programs      Program[]
  curationStops CurationStop[]
  visits        Visit[]

  @@index([district])
  @@index([status, isPublic])
}

// 예약/참여 가능한 작가 프로그램 (전시와 구분)
model Program {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  // OPEN_STUDIO | ARTIST_TALK | WORKSHOP | TOUR
  type         String  @default("OPEN_STUDIO")
  // 공간 또는 전시 중 최소 하나 필요 (전시 연계 프로그램은 space 없이 가능)
  spaceId      String?
  exhibitionId String?
  hostUserId   String?
  summary      String?
  description  String?
  // 자유 구성 소개 본문 (텍스트/이미지 블록 JSON)
  storyJson    String  @default("[]")
  heroTone     String  @default("linear-gradient(135deg, #e8e2f2 0%, #9c8db8 55%, #4a3d63 100%)")
  heroImageUrl String?
  // 추가 이미지 URL 목록 (JSON 배열)
  imageUrls    String  @default("[]")
  startDate    String
  endDate      String
  // 날짜별 시간·정원 (Exhibition.reservationSlots와 동일 포맷)
  reservationSlots    String  @default("[]")
  reservationRequired Boolean @default(true)
  // 취소/방문 정책 안내
  policyNote String?
  isPublic   Boolean @default(true)
  // PUBLISHED | DRAFT | HIDDEN
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space        Space?        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  exhibition   Exhibition?   @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)
  host         User?         @relation("HostedPrograms", fields: [hostUserId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  visits       Visit[]

  @@index([spaceId])
  @@index([exhibitionId])
  @@index([status, isPublic])
}

model Exhibition {
  id             String @id
  title          String
  artist         String
  region         String @default("서울")
  district       String
  venue          String
  address        String
  lat            Float
  lng            Float
  startDate      String
  endDate        String
  categories     String
  exhibitionType String
  // 데이터 출처: PUBLIC_API | ADMIN | ARTIST | USER_REPORT
  source            String   @default("ADMIN")
  curationAvailable Boolean  @default(false)
  reservable        Boolean  @default(true)
  todayOpen         Boolean  @default(false)
  popular           Boolean  @default(false)
  nearby            Boolean  @default(false)
  // 홈 히어로 슬라이드에 고정. 꺼져 있으면 최신 등록순으로 채워진다.
  homeHero          Boolean  @default(false)
  heroTone          String
  heroImageUrl      String?
  summary           String
  description       String
  // 소개글 본문에 삽입되는 이미지 URL 목록 (JSON 배열)
  descriptionImages String   @default("[]")
  reservationSlots  String   @default("[]")
  // 노출 상태 (운영): PUBLISHED | DRAFT | PENDING_REVIEW | HIDDEN
  status            String   @default("PUBLISHED")
  // 전시 라이프사이클 수동 오버라이드: null(자동) | EXTENDED | CANCELLED
  lifecycleOverride String?
  viewCount         Int      @default(0)
  registeredById    String?
  reviewedById      String?
  // 이 전시가 열리는 공방/쇼룸 (선택)
  spaceId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  artistVideoTitle      String?
  artistVideoDuration   String?
  artistVideoPosterTone String?
  artistVideoUrl        String?
  artistVideoStatus     String?

  registeredBy  User?                @relation("RegisteredExhibitions", fields: [registeredById], references: [id], onDelete: SetNull)
  reviewedBy    User?                @relation("ReviewedExhibitions", fields: [reviewedById], references: [id], onDelete: SetNull)
  space         Space?               @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  artworks      Artwork[]
  reservations  Reservation[]
  tags          ExhibitionTag[]
  curations     CurationExhibition[]
  curationStops CurationStop[]
  saves         SaveExhibition[]
  visits        Visit[]
  reviews       Review[]
  eventLogs     EventLog[]
  programs      Program[]
  artistQuestions ArtistQuestion[]

  @@index([homeHero, createdAt])
}

model Artwork {
  id           String  @id @default(cuid())
  exhibitionId String
  title        String
  artist       String
  material     String
  price        Int?
  imageTone    String
  imageUrl     String?

  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  // CURATION | MOOD | PURPOSE
  type      String   @default("CURATION")
  createdAt DateTime @default(now())

  exhibitions ExhibitionTag[]
}

model ExhibitionTag {
  exhibitionId String
  tagId        String

  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([exhibitionId, tagId])
}

model Place {
  id         String    @id @default(cuid())
  name       String
  // CAFE | RESTAURANT | WALK | ETC
  type       String    @default("CAFE")
  region     String    @default("서울")
  district   String
  address    String
  lat        Float
  lng        Float
  tags       String    @default("[]")
  sourceUrl  String?
  notes      String?
  imageUrl   String?
  // 홈 «나만 알고 싶었던 곳인데» 카드용 한 줄
  editorialNote String?
  homeFeatured  Boolean @default(false)
  homeSortOrder Int     @default(0)
  isActive   Boolean   @default(true)
  usedCount  Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  curations     Curation[]
  curationStops CurationStop[]
  tips          PlaceTip[]
  visits        Visit[]

  @@index([homeFeatured, homeSortOrder])
}

// 관객 장소 제보 — 검수 후 Place로 채택
model PlaceTip {
  id         String   @id @default(cuid())
  userId     String
  name       String
  sourceUrl  String?
  // BEFORE | AFTER | SOLO | DATE | MEAL | OTHER
  situation  String
  district   String
  imageUrl   String?
  // PENDING | ADOPTED | REJECTED
  status     String   @default("PENDING")
  placeId    String?
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// 관객 → 작가 질문. 등록 작가는 검수 후 전달, 미등록 작가는 운영이 대신 묻고 답한다.
model ArtistQuestion {
  id                 String   @id @default(cuid())
  // REGISTERED | UNLISTED
  kind               String   @default("REGISTERED")
  // EXHIBITION | ARTWORK | VISIT
  topic              String
  artistUserId       String?
  unlistedArtistName String?
  exhibitionId       String?
  fromUserId         String?
  fromName           String
  fromEmail          String
  body               String
  // PENDING | APPROVED | REJECTED | ANSWERED | FORWARDED
  status             String   @default("PENDING")
  adminNote          String?
  answer             String?
  answeredAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  artist     User?       @relation("QuestionsReceived", fields: [artistUserId], references: [id], onDelete: SetNull)
  from       User?       @relation("QuestionsAsked", fields: [fromUserId], references: [id], onDelete: SetNull)
  exhibition Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([artistUserId, status])
  @@index([fromEmail, createdAt])
}

model Curation {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  description    String?
  // 자유 구성 소개 본문 (텍스트/이미지 블록 JSON)
  storyJson      String   @default("[]")
  // 소개 이미지 URL 목록 (JSON 배열) — storyJson 미사용 시 갤러리
  descriptionImages String @default("[]")
  coverTone      String   @default("linear-gradient(135deg, #ffd9c0 0%, #ff8f6b 100%)")
  coverImageUrl  String?
  published      Boolean  @default(true)
  // 홈 히어로에 우선 노출 (관리자가 지정, 여러 개면 최신 featured 우선)
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  neighborhood   String?
  situationTags  String   @default("[]")
  basePlaceId    String?
  radiusMeters   Int      @default(800)
  durationText   String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  basePlace   Place?               @relation(fields: [basePlaceId], references: [id], onDelete: SetNull)
  exhibitions CurationExhibition[]
  stops       CurationStop[]
}

// 큐레이션 동선의 순서 있는 정차 지점 — 공간/전시/장소를 하나의 코스로 연결
// 애플리케이션 레벨에서 stopType에 해당하는 대상 id 하나만 연결되도록 검증한다
model CurationStop {
  id         String  @id @default(cuid())
  curationId String
  sortOrder  Int     @default(0)
  // SPACE | EXHIBITION | PLACE
  stopType     String
  spaceId      String?
  exhibitionId String?
  placeId      String?
  editorialBadge String?
  distanceText   String?
  note           String?

  curation   Curation    @relation(fields: [curationId], references: [id], onDelete: Cascade)
  space      Space?      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  exhibition Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  place      Place?      @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([curationId, sortOrder])
}

model CurationExhibition {
  curationId     String
  exhibitionId   String
  sortOrder      Int     @default(0)
  editorialBadge String?
  distanceText   String?

  curation   Curation   @relation(fields: [curationId], references: [id], onDelete: Cascade)
  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@id([curationId, exhibitionId])
}

model SaveExhibition {
  id           String   @id @default(cuid())
  userId       String
  exhibitionId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@unique([userId, exhibitionId])
}

// 방문 기록 — 전시뿐 아니라 공간/프로그램에도 남길 수 있다 (사용자 자기 기록)
model Visit {
  id           String   @id @default(cuid())
  userId       String
  exhibitionId String?
  spaceId      String?
  programId    String?
  placeId      String?
  visitedAt    DateTime @default(now())
  // 손님이 남긴 방문 사진. 원본 카드 이미지는 건드리지 않는다.
  photoUrl     String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exhibition Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  space      Space?      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  program    Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)
  place      Place?      @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, exhibitionId])
  @@unique([userId, spaceId])
  @@unique([userId, programId])
  @@unique([userId, placeId])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  exhibitionId String
  // 왓챠피디아식 추천 여부 (필수)
  recommend    Boolean
  // 선택 태그 (만족도/공간/재방문 등, JSON 배열)
  moodTags     String   @default("[]")
  memo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@unique([userId, exhibitionId])
}

// 예약 — 전시(작가와 대화) 또는 프로그램 중 정확히 하나를 대상으로 한다
model Reservation {
  id           String   @id @default(cuid())
  userId       String
  exhibitionId String?
  programId    String?
  visitDate    String
  slot         String
  status       String   @default("CONFIRMED")
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exhibition Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  program    Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, exhibitionId, visitDate, slot])
  @@unique([userId, programId, visitDate, slot])
}

model EventLog {
  id            String   @id @default(cuid())
  type          String
  userId        String?
  exhibitionId  String?
  reservationId String?
  source        String?
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  exhibition Exhibition? @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([userId])
  @@index([exhibitionId])
  @@index([createdAt])
}

model NotificationLog {
  id            String   @id @default(cuid())
  userId        String
  type          String
  channel       String   @default("email")
  dedupeKey     String
  exhibitionId  String?
  reservationId String?
  status        String   @default("sent")
  metadata      String   @default("{}")
  sentAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey, channel])
  @@index([type, sentAt])
}

// 웹 안 알림. 질문 답변·전시 종료 임박 등. 이메일은 보조 채널.
model Notice {
  id        String    @id @default(cuid())
  userId    String
  // QUESTION_ANSWER | QUESTION_RECEIVED | QUESTION_REJECTED | EXHIBITION_ENDING
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  dedupeKey String
  createdAt DateTime  @default(now())
  metadata  String    @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// 손님이 모은 카드. 원본 전시/장소는 복제하지 않고 cardKey로 가리킨다.
model SavedCard {
  id        String   @id @default(cuid())
  userId    String
  cardKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardKey])
  @@index([userId, createdAt])
}

// MY DECK — 손님이 고른 카드 묶음. 운영 큐레이션(Curation)과 구분한다.
model UserDeck {
  id            String   @id @default(cuid())
  userId        String
  title         String
  subtitle      String?
  accentColor   String   @default("#C46D54")
  shareToken    String?  @unique
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards UserDeckCard[]
  calendarEntries CalendarEntry[]

  @@index([userId, updatedAt])
}

model UserDeckCard {
  id        String   @id @default(cuid())
  deckId    String
  cardKey   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  deck UserDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardKey])
  @@index([deckId, sortOrder])
}

// 날짜에 카드·덱을 붙이는 아카이브. 다녀온 날과 다음 주말 코스를 같은 달력에 담는다.
model CalendarEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String
  // CARD | DECK
  kind      String
  cardKey   String?
  deckId    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck UserDeck? @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([deckId])
}

model CalendarShare {
  id         String   @id @default(cuid())
  userId     String
  date       String
  shareToken String   @unique
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
